generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DailyEntry {
  id              String        @id @default(cuid())
  date            DateTime      @unique @db.Date
  waterMl         Int           @default(0)
  walkingKm       Decimal       @default(0) @db.Decimal(8, 2)
  runningKm       Decimal       @default(0) @db.Decimal(8, 2)
  meals           Meal[]
  goals           GoalCompletion[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([date])
}

model Meal {
  id           String     @id @default(cuid())
  dailyEntryId String
  name         String
  notes        String?
  dailyEntry   DailyEntry @relation(fields: [dailyEntryId], references: [id], onDelete: Cascade)

  @@index([dailyEntryId])
}

model GoalCompletion {
  id           String     @id @default(cuid())
  dailyEntryId String
  goal         String
  completed    Boolean    @default(true)
  dailyEntry   DailyEntry @relation(fields: [dailyEntryId], references: [id], onDelete: Cascade)

  @@index([dailyEntryId])
}
